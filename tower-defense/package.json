{
  "name": "tower-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "node -e \"process.env.TD_BALANCE='1';require('child_process').execSync('npx vitest run --silent=false',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "howler": "^2.2.4",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
